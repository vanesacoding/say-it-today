    },
    "sentence-long-run": {
      "text": "It may be inconvenient at first, but I think the benefits outweigh the drawbacks in the long run.",
      "file": "sentence-long-run-bc7b5f3408c0.mp3"
    },
    "sentence-point": {
      "text": "I see your point, although I'm not entirely convinced that it would work in practice.",
      "file": "sentence-point-1a7f076ebfe5.mp3"
    },
    "sentence-priority": {
      "text": "What matters most to me is having enough time to pursue my interests outside work.",
      "file": "sentence-priority-75691140287e.mp3"
    },
    "sentence-variety": {
      "text": "What appeals to me about a buffet is the variety, although I try not to take more than I can finish.",
      "file": "sentence-variety-762fa4e7ad59.mp3"
    },
    "sentence-dietary": {
      "text": "Would you mind letting me know which dishes are suitable for someone with dietary restrictions?",
      "file": "sentence-dietary-ac0e82a4b6d1.mp3"
    },
    "sentence-portion": {
      "text": "I'd rather start with a small portion and go back for more if I'm still hungry.",
      "file": "sentence-portion-8d67a69a91fe.mp3"
    },
    "sentence-value-money": {
      "text": "It seems reasonably priced, provided that the quality lives up to our expectations.",
      "file": "sentence-value-money-2390fb1903b9.mp3"
    },
    "sentence-seasonal": {
      "text": "I tend to choose seasonal ingredients because they're often fresher and have more flavour.",
      "file": "sentence-seasonal-d9da54c2ee11.mp3"
    },
    "sentence-meal": {
      "text": "For me, eating out is as much about spending time with people as it is about the food.",
      "file": "sentence-meal-8dcf0e549089.mp3"
    },
    "sentence-cafe-quiet": {
      "text": "I usually go for somewhere quiet, where I can unwind without feeling rushed.",
      "file": "sentence-cafe-quiet-7a17ad5835a6.mp3"
    },
    "sentence-cut-back": {
      "text": "I've been trying to cut back on caffeine, so I'll have something without coffee today.",
      "file": "sentence-cut-back-21330255f4f8.mp3"
    },
    "sentence-too-sweet": {
      "text": "Could you make it a little less sweet? I find the regular version slightly overpowering.",
      "file": "sentence-too-sweet-acae178b6a8a.mp3"
    },
    "sentence-atmosphere": {
      "text": "The coffee is decent, but it's the relaxed atmosphere that keeps me coming back.",
      "file": "sentence-atmosphere-fc7a3b91425f.mp3"
    },
    "sentence-work-cafe": {
      "text": "Working in a cafe can be refreshing, as long as the background noise doesn't become distracting.",
      "file": "sentence-work-cafe-629c7c546fc8.mp3"
    },
    "sentence-local": {
      "text": "I'd rather support an independent cafe, even if it costs a little more than a chain.",
      "file": "sentence-local-bb393d97ad5b.mp3"
    },
    "sentence-off-beaten": {
      "text": "I enjoy visiting places off the beaten track because they give me a better sense of local life.",
      "file": "sentence-off-beaten-7309ac16f675.mp3"
    },
    "sentence-transport": {
      "text": "Public transport is usually my first choice, unless I'm carrying too much luggage.",
      "file": "sentence-transport-70919d7d51d7.mp3"
    },
    "sentence-location": {
      "text": "I'd prefer a centrally located hotel, even if the room is slightly smaller.",
      "file": "sentence-location-def1b58ef10d.mp3"
    },
    "sentence-delay": {
      "text": "Our train was delayed, which meant we had to change our plans at the last minute.",
      "file": "sentence-delay-18f0bfdb047e.mp3"
    },
    "sentence-make-most": {
      "text": "With only a couple of days available, we tried to make the most of our time without rushing around.",
      "file": "sentence-make-most-3093474b6e0a.mp3"
    },
    "sentence-travel-perspective": {
      "text": "Travelling has broadened my perspective by exposing me to ways of life different from my own.",
      "file": "sentence-travel-perspective-9fb353cadcc5.mp3"
