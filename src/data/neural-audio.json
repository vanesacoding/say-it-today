    },
    "sentence-balance": {
      "text": "I value flexibility because it helps me strike a balance between work and personal life.",
      "file": "sentence-balance-ffdb0173a2f8.mp3"
    },
    "sentence-weigh-up": {
      "text": "Before making a decision, I tend to weigh up the pros and cons rather than rush into it.",
