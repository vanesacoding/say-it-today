    "sourceCover": "https://bookdash.org/wp-content/uploads/2022/05/how-do-you-sleep_en_20220520_cover-2.jpg",
    "sourceCoverSha256": "0b503a777049df404c1c6a61bfc12c8ab65c66c1ffeb2e91073c52d6b38c7236",
    "pages": [
      {
        "sourcePageNumber": 4,
        "sourceText": "",
        "sourceImage": "https://bookdash.org/wp-content/uploads/2022/05/how-do-you-sleep_en_20220520_page4-scaled.jpg",
        "sourceImageSha256": "b0351566a057e162dce78315c5fd5a20a7716c07acc942a4108e80c009796bc1",
        "imageWidth": 2560,
        "imageHeight": 1280
      },
      {
        "sourcePageNumber": 5,
        "sourceText": "How do you sleep, bird? I fly in my sleep.",
        "sourceImage": "https://bookdash.org/wp-content/uploads/2022/05/how-do-you-sleep_en_20220520_page5-scaled.jpg",
        "sourceImageSha256": "a096056bbc93e80c4784a6bab00d8ba272e95fb959b7bfdbfc03dab692dff5c5",
        "imageWidth": 2560,
        "imageHeight": 1280
      },
      {
        "sourcePageNumber": 6,
        "sourceText": "How do you sleep, bat? I sleep upside down.",
        "sourceImage": "https://bookdash.org/wp-content/uploads/2022/05/how-do-you-sleep_en_20220520_page6-scaled.jpg",
        "sourceImageSha256": "248f29259ed6a29dab2ae9ef6728c0253d28198859280f2cd407fbcbf80c5e98",
        "imageWidth": 2560,
        "imageHeight": 1280
      },
      {
        "sourcePageNumber": 7,
        "sourceText": "How do you sleep, bullfrog? I rest on my side.",
        "sourceImage": "https://bookdash.org/wp-content/uploads/2022/05/how-do-you-sleep_en_20220520_page7-scaled.jpg",
        "sourceImageSha256": "691fa5abf8da6f2d51a128e09037ef36f5a0c1d45cfdcd07d6a40555aedcceeb",
        "imageWidth": 2560,
        "imageHeight": 1280
      },
      {
        "sourcePageNumber": 8,
        "sourceText": "How do you sleep, octopus? I change colour in my dreams.",
        "sourceImage": "https://bookdash.org/wp-content/uploads/2022/05/how-do-you-sleep_en_20220520_page8-scaled.jpg",
        "sourceImageSha256": "98495731d319d3dc297f29a52dc65685c03a26f498dde86b80a5c3406b1beb0f",
        "imageWidth": 2560,
        "imageHeight": 1280
      },
      {
        "sourcePageNumber": 9,
        "sourceText": "How do you sleep, duck? We take turns to guard each other.",
        "sourceImage": "https://bookdash.org/wp-content/uploads/2022/05/how-do-you-sleep_en_20220520_page9-scaled.jpg",
        "sourceImageSha256": "eeaca8e8cbf727a4e9daf6b1fcbc71f213ed7d5ded02fc73bdbd04fe296aec0b",
        "imageWidth": 2560,
        "imageHeight": 1280
      },
      {
        "sourcePageNumber": 10,
        "sourceText": "How do you sleep, baby owl? I sleep on my face.",
        "sourceImage": "https://bookdash.org/wp-content/uploads/2022/05/how-do-you-sleep_en_20220520_page10-scaled.jpg",
        "sourceImageSha256": "0043472ddc8afc0eadc22149394e8d834d5c9b12ec4e910e30e26e5d75aa5e4e",
        "imageWidth": 2560,
        "imageHeight": 1280
      },
      {
        "sourcePageNumber": 11,
        "sourceText": "How do you sleep, otter? We sleep holding hands.",
        "sourceImage": "https://bookdash.org/wp-content/uploads/2022/05/how-do-you-sleep_en_20220520_page11-scaled.jpg",
        "sourceImageSha256": "50f794a571435eee22e0e9139dc14cc45f5118af3f15cf276733a88ea6779458",
        "imageWidth": 2560,
        "imageHeight": 1280
      },
      {
        "sourcePageNumber": 12,
        "sourceText": "How do you sleep, walrus? I sleep on the land and under the water.",
        "sourceImage": "https://bookdash.org/wp-content/uploads/2022/05/how-do-you-sleep_en_20220520_page12-scaled.jpg",
        "sourceImageSha256": "5c0d5de4a2323a0366a215f0a08e9b59d510afe4c72055bdf1bc0fbed3c82d13",
        "imageWidth": 2560,
        "imageHeight": 1280
      },
      {
        "sourcePageNumber": 13,
        "sourceText": "How do you sleep, giraffe? We sleep on each other.",
        "sourceImage": "https://bookdash.org/wp-content/uploads/2022/05/how-do-you-sleep_en_20220520_page13-scaled.jpg",
        "sourceImageSha256": "0d8f3e0c3916df1209e25f6b9b1f59c120c5a73599b505ad7f7a0d6053e45ec1",
        "imageWidth": 2560,
        "imageHeight": 1280
      },
      {
        "sourcePageNumber": 14,
        "sourceText": "How do you sleep, meerkat? We sleep in a heap.",
        "sourceImage": "https://bookdash.org/wp-content/uploads/2022/05/how-do-you-sleep_en_20220520_page14-scaled.jpg",
        "sourceImageSha256": "72655c5e62a21c3662fbb32289a855cafc2a5ebcafdd0f8c57048650b0e41a40",
        "imageWidth": 2560,
        "imageHeight": 1280
      },
      {
        "sourcePageNumber": 15,
        "sourceText": "How do you sleep, Pula? Goodnight! Sleep tight!",
        "sourceImage": "https://bookdash.org/wp-content/uploads/2022/05/how-do-you-sleep_en_20220520_page15-scaled.jpg",
        "sourceImageSha256": "4c82a05fff91ceab15ca1adc8a4b3225a3341064b8845e1bd42ae33eb471d6af",
        "imageWidth": 2560,
        "imageHeight": 1280
      }
    ]
  },
  {
    "bookId": "how-do-you-eat",
    "sourceUrl": "https://bookdash.org/books/how-do-you-eat/",
    "license": "CC-BY-4.0",
    "creators": [
      "文字：Diane Awerbuck",
      "插画：Alex Latimer",
      "设计：Georgia Demertzis",
      "编辑：Katie Huston"
    ],
    "sourceCover": "https://bookdash.org/wp-content/uploads/2025/10/how-do-you-eat_en_cover-1.jpg",
    "sourceCoverSha256": "37a0c03f3f01984bb9a5153801d0bb93c4472fe22be796ffeceb66ada250a6dd",
    "pages": [
      {
        "sourcePageNumber": 4,
        "sourceText": "Miri likes to crunch her toast.",
        "sourceImage": "https://bookdash.org/wp-content/uploads/2025/10/how-do-you-eat_en_page4-scaled.jpg",
        "sourceImageSha256": "cf91fd882de5ef21cf11ed690d6fc85739ddf5149e47ca2c393314895d996df6",
        "imageWidth": 2560,
        "imageHeight": 1280
      },
      {
        "sourcePageNumber": 5,
        "sourceText": "How do you eat, flamingo? I eat upside down! I trap shrimp in my beak.",
        "sourceImage": "https://bookdash.org/wp-content/uploads/2025/10/how-do-you-eat_en_page5-scaled.jpg",
        "sourceImageSha256": "8fc98bed79a3b23be90a9b378671e27739bde4c6e02d0ad3124122426d28e351",
        "imageWidth": 2560,
        "imageHeight": 1280
      },
      {
        "sourcePageNumber": 6,
        "sourceText": "How do you eat, dung beetle? I roll dung into a ball. I chew the wet bits and my babies munch the grass.",
        "sourceImage": "https://bookdash.org/wp-content/uploads/2025/10/how-do-you-eat_en_page6-scaled.jpg",
        "sourceImageSha256": "f927519798e8e201133f6eb827f06401e203ca5dd4ba1fed9168fca1be580710",
        "imageWidth": 2560,
        "imageHeight": 1280
      },
      {
        "sourcePageNumber": 7,
        "sourceText": "How do you eat, pangolin? I lick up ants with my long, sticky tongue.",
        "sourceImage": "https://bookdash.org/wp-content/uploads/2025/10/how-do-you-eat_en_page7-scaled.jpg",
        "sourceImageSha256": "10182f6e9a9fad8a24ab960f4366b4849de992dcab8132975b980743a02bf7e3",
        "imageWidth": 2560,
        "imageHeight": 1280
      },
      {
        "sourcePageNumber": 8,
        "sourceText": "How do you eat, earthworm? I don’t have teeth. I swallow soil!",
        "sourceImage": "https://bookdash.org/wp-content/uploads/2025/10/how-do-you-eat_en_page8-scaled.jpg",
        "sourceImageSha256": "01225f6f446af86b2174e91102c6b86f0ad59271ccc4c3fd579e81b6d02e1e1e",
        "imageWidth": 2560,
        "imageHeight": 1280
      },
      {
        "sourcePageNumber": 9,
        "sourceText": "How do you eat, tickbird? I ride on animals and snack on their ticks and earwax.",
        "sourceImage": "https://bookdash.org/wp-content/uploads/2025/10/how-do-you-eat_en_page9-scaled.jpg",
        "sourceImageSha256": "b627a5c496890ae512af0c76ef3738f0198175c01060befe7fddd05ccc8a7272",
        "imageWidth": 2560,
        "imageHeight": 1280
      },
      {
        "sourcePageNumber": 10,
        "sourceText": "How do you eat, whale? I sing to find my supper. The sound bounces off the fish!",
        "sourceImage": "https://bookdash.org/wp-content/uploads/2025/10/how-do-you-eat_en_page10-scaled.jpg",
        "sourceImageSha256": "9699b00ecd394a1287457775dc7d82f4de34f939fb1e2ff81f1374bc00b1f643",
        "imageWidth": 2560,
        "imageHeight": 1280
      },
      {
        "sourcePageNumber": 11,
        "sourceText": "How do you eat, tortoise? I munch prickly pears with my hard mouth.",
        "sourceImage": "https://bookdash.org/wp-content/uploads/2025/10/how-do-you-eat_en_page11-scaled.jpg",
        "sourceImageSha256": "4008e02ea067e75c547402dd5b78e5bb8c3cb9ace64cfb6d9f71169bbd49164c",
        "imageWidth": 2560,
        "imageHeight": 1280
      },
      {
        "sourcePageNumber": 12,
        "sourceText": "How do you eat, secretary bird? I stomp on snakes. I slurp them up!",
        "sourceImage": "https://bookdash.org/wp-content/uploads/2025/10/how-do-you-eat_en_page12-scaled.jpg",
        "sourceImageSha256": "8b8167221db3982f8f4ddae190dfe73dd002bd97e4f4e2ef480420f7f8e5ae64",
        "imageWidth": 2560,
        "imageHeight": 1280
      },
      {
        "sourcePageNumber": 13,
        "sourceText": "How do you eat, giraffe? I stretch my neck and grab the highest leaves.",
        "sourceImage": "https://bookdash.org/wp-content/uploads/2025/10/how-do-you-eat_en_page13-scaled.jpg",
        "sourceImageSha256": "ff79366ad706f4dff282372f970127506b2a7701ff9457ca2421ee9536a3f454",
        "imageWidth": 2560,
        "imageHeight": 1280
      },
      {
        "sourcePageNumber": 14,
        "sourceText": "How do you eat, ostrich? I swallow little stones to break up my food.",
        "sourceImage": "https://bookdash.org/wp-content/uploads/2025/10/how-do-you-eat_en_page14-scaled.jpg",
        "sourceImageSha256": "ee536f283b821f71e05dd05765060a5ffdcc7675b9992f3dbf42815c7faf6c09",
        "imageWidth": 2560,
        "imageHeight": 1280
      },
      {
        "sourcePageNumber": 15,
        "sourceText": "Miri, what is the best way to eat? Oh, she’s too busy to chat! Nibble! Chew! Munch! Gobble! Slurp! Nibble! Chew! Nibble! Chew! Slurp! BURP! Excuse me!",
        "sourceImage": "https://bookdash.org/wp-content/uploads/2025/10/how-do-you-eat_en_page15-scaled.jpg",
        "sourceImageSha256": "ebd09975732a9d02e4dc303d2cec52c313acf5ace4f9af3a790e8f5681bd8a9d",
        "imageWidth": 2560,
        "imageHeight": 1280
      }
    ]
  }
]
