        "sourceAudioTextSha256": "f192b704db2b4e755e5fa1f898a1e70a4dfe6e3186ab9536f651a3b250722c5e",
        "audioDurationSeconds": 1.944
      },
      {
        "en": "I have many tricks.",
        "sourceText": "I have many tricks.",
        "zh": "我有许多本领。",
        "tip": "看看火还能做什么。",
        "alt": "我有许多本领。",
        "sourceImage": "https://raw.githubusercontent.com/global-asp/asp-imagebank/a56e6dbe7aeeb8ea3e53d9941664416e2e7356ad/medium/0043/07.jpg",
        "sourceImageSha256": "d407a8f316f3b57f65ee92fcb7a5a50cacec7911a7e38ce1ce8f750b2507fb2d",
        "imageWidth": 534,
        "imageHeight": 546,
        "audioFile": "audio/06-50e038fabc6b30d6.mp3",
        "sourceAudio": "https://vanesacoding.github.io/say-it-today/books/library/0043/audio/06-50e038fabc6b30d6.mp3",
        "sourceAudioSha256": "50e038fabc6b30d6e5ea5e90c421899911359f70cba0858f5ff5e3bdc9ec3df1",
        "sourceAudioTextSha256": "61e067386fe394e3c9a8821cd597d051958fec1bbbd17480b8380977f87d532e",
        "audioDurationSeconds": 2.376
      },
      {
        "en": "I am part of your family.",
        "sourceText": "I am part of your family.",
        "zh": "我是你家庭的一部分。",
        "tip": "找找大人怎样使用火。",
        "alt": "我是你家庭的一部分。",
        "sourceImage": "https://raw.githubusercontent.com/global-asp/asp-imagebank/a56e6dbe7aeeb8ea3e53d9941664416e2e7356ad/medium/0043/08.jpg",
        "sourceImageSha256": "eec1db1956bee63f55f238e1cce3945078b9604e2dd193dda392a443461cf7d4",
        "imageWidth": 534,
        "imageHeight": 546,
        "audioFile": "audio/07-ed16525096c68b85.mp3",
        "sourceAudio": "https://vanesacoding.github.io/say-it-today/books/library/0043/audio/07-ed16525096c68b85.mp3",
        "sourceAudioSha256": "ed16525096c68b85d66f4946756d266b61ad58efd467504cc982a5aa7b65a167",
        "sourceAudioTextSha256": "81a04870bebad2307d538e18b0f7b8126b86bfbd21520fedb9e6bf918e79a17b",
        "audioDurationSeconds": 2.568
      },
      {
        "en": "But be careful when you invite me to your home. I don't like to be left alone.",
        "sourceText": "But be careful when you invite me to your home. I don't like to be left alone.",
        "zh": "不过，请我到家里时要小心。我不喜欢被单独留下。",
