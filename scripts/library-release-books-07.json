    "pages": [
      {
        "en": "She is called Ms Phone. Look at her!",
        "sourceText": "She is called Ms Phone. Look at her!",
        "zh": "大家叫她“手机女士”，快来看她！",
        "tip": "指指这位女士，认识故事主角。",
        "alt": "大家叫她“手机女士”，快来看她！",
        "sourceImage": "https://raw.githubusercontent.com/global-asp/asp-imagebank/a56e6dbe7aeeb8ea3e53d9941664416e2e7356ad/medium/0105/02.jpg",
        "sourceImageSha256": "85ff17f61a31fc5b44156129788286d54a66afec5ad526510d2b061c37d308e4",
        "imageWidth": 592,
        "imageHeight": 546
      },
      {
        "en": "She has five cellphones. When she wakes up, she arranges her cellphones on the table.",
        "sourceText": "She has five cellphones. When she wakes up, she arranges her cellphones on the table.",
        "zh": "她有五部手机。每天醒来，她会把手机摆在桌上。",
        "tip": "一起数一数五部手机。",
        "alt": "她有五部手机。每天醒来，她会把手机摆在桌上。",
        "sourceImage": "https://raw.githubusercontent.com/global-asp/asp-imagebank/a56e6dbe7aeeb8ea3e53d9941664416e2e7356ad/medium/0105/03.jpg",
        "sourceImageSha256": "caf795d2e4c32602f26ebdb0ee220610d4f2c7a151562724183ac4d46cc4a38e",
        "imageWidth": 543,
        "imageHeight": 546
      },
      {
        "en": "The yellow one is for communicating with family.",
        "sourceText": "The yellow one is for communicating with family.",
        "zh": "黄色手机用来联系家人。",
        "tip": "找到黄色的手机，听 yellow。",
        "alt": "黄色手机用来联系家人。",
        "sourceImage": "https://raw.githubusercontent.com/global-asp/asp-imagebank/a56e6dbe7aeeb8ea3e53d9941664416e2e7356ad/medium/0105/04.jpg",
        "sourceImageSha256": "bad967d3bc3b0f88033b707e44971cdf10894a665016099c4563e7eaeb578f86",
        "imageWidth": 539,
        "imageHeight": 546
      },
      {
        "en": "The white one is for communicating with people at work.",
        "sourceText": "The white one is for communicating with people at work.",
        "zh": "白色手机用来联系工作中的人。",
        "tip": "找一找白色手机。",
        "alt": "白色手机用来联系工作中的人。",
        "sourceImage": "https://raw.githubusercontent.com/global-asp/asp-imagebank/a56e6dbe7aeeb8ea3e53d9941664416e2e7356ad/medium/0105/05.jpg",
        "sourceImageSha256": "dfefbaa7a54884deb1300b6a13033e6d4719af3df89d20891ca1bb71ec036ed7",
        "imageWidth": 612,
        "imageHeight": 546
      },
      {
        "en": "The red one is for communicating with those who owe her something.",
        "sourceText": "The red one is for communicating with those who owe her something.",
        "zh": "红色手机用来联系欠她东西的人。",
        "tip": "找一找红色手机，不必解释复杂借贷。",
        "alt": "红色手机用来联系欠她东西的人。",
        "sourceImage": "https://raw.githubusercontent.com/global-asp/asp-imagebank/a56e6dbe7aeeb8ea3e53d9941664416e2e7356ad/medium/0105/06.jpg",
        "sourceImageSha256": "d66dcabd06904d76e82f70089edcbad39d606ca904fb3ca311ec86497784fac6",
        "imageWidth": 598,
        "imageHeight": 546
      },
      {
        "en": "The pink one is for communicating with her best friends.",
        "sourceText": "The pink one is for communicating with her best friends.",
        "zh": "粉色手机用来联系她最好的朋友。",
        "tip": "指指粉色，说说想联系哪位朋友。",
        "alt": "粉色手机用来联系她最好的朋友。",
        "sourceImage": "https://raw.githubusercontent.com/global-asp/asp-imagebank/a56e6dbe7aeeb8ea3e53d9941664416e2e7356ad/medium/0105/07.jpg",
        "sourceImageSha256": "16d740566726a6e3ee8bea72a23c315cbb8bc5ab0d9128ac47040446975c791c",
        "imageWidth": 564,
        "imageHeight": 546
      },
      {
        "en": "The purple one is for communicating with people who need her help.",
        "sourceText": "The purple one is for communicating with people who need her help.",
        "zh": "紫色手机用来联系需要她帮助的人。",
        "tip": "听 help，说“帮忙”。",
        "alt": "紫色手机用来联系需要她帮助的人。",
        "sourceImage": "https://raw.githubusercontent.com/global-asp/asp-imagebank/a56e6dbe7aeeb8ea3e53d9941664416e2e7356ad/medium/0105/08.jpg",
        "sourceImageSha256": "5e72c47f25a3d203b9404d7184edb38ad32adc9205985e8bb273871e6e30bd6a",
        "imageWidth": 617,
        "imageHeight": 546
      },
      {
        "en": "Ms Phone likes people to be happy. She does not like fighting.",
        "sourceText": "Ms Phone likes people to be happy. She does not like fighting.",
        "zh": "手机女士喜欢大家开心，不喜欢争吵。",
        "tip": "看看她和人们相处的样子。",
        "alt": "手机女士喜欢大家开心，不喜欢争吵。",
        "sourceImage": "https://raw.githubusercontent.com/global-asp/asp-imagebank/a56e6dbe7aeeb8ea3e53d9941664416e2e7356ad/medium/0105/09.jpg",
        "sourceImageSha256": "99a63a6d7d8cfb9de26b078b376bc2bfbb941403f80c9673ab9da03820bf11dd",
        "imageWidth": 547,
        "imageHeight": 546
      },
      {
        "en": "She lets the children watch television at her shop.",
        "sourceText": "She lets the children watch television at her shop.",
        "zh": "她让孩子们在自己的店里看电视。",
        "tip": "指指画面里的孩子们。",
        "alt": "她让孩子们在自己的店里看电视。",
        "sourceImage": "https://raw.githubusercontent.com/global-asp/asp-imagebank/a56e6dbe7aeeb8ea3e53d9941664416e2e7356ad/medium/0105/10.jpg",
        "sourceImageSha256": "3218a71121ab3371a30f4521575d837d1b2edee8aa13214af3412fb0d390eb12",
        "imageWidth": 554,
        "imageHeight": 546
      },
      {
        "en": "She visits the sick and the elderly in their homes.",
        "sourceText": "She visits the sick and the elderly in their homes.",
        "zh": "她到生病的人和老人的家里探望。",
        "tip": "说说关心家人可以做的一件小事。",
        "alt": "她到生病的人和老人的家里探望。",
        "sourceImage": "https://raw.githubusercontent.com/global-asp/asp-imagebank/a56e6dbe7aeeb8ea3e53d9941664416e2e7356ad/medium/0105/11.jpg",
        "sourceImageSha256": "b4e0a24ebea35866762cfb3c2c36f849100cff7ad43615e426e273c07e27cba9",
        "imageWidth": 560,
        "imageHeight": 546
      },
      {
        "en": "When she passes, there are shouts of \"Ms Phone! Ms Phone!\"",
        "sourceText": "When she passes, there are shouts of \"Ms Phone! Ms Phone!\"",
        "zh": "她走过时，大家纷纷喊：“手机女士！手机女士！”",
        "tip": "轻轻挥手，演一演打招呼。",
        "alt": "她走过时，大家纷纷喊：“手机女士！手机女士！”",
        "sourceImage": "https://raw.githubusercontent.com/global-asp/asp-imagebank/a56e6dbe7aeeb8ea3e53d9941664416e2e7356ad/medium/0105/12.jpg",
        "sourceImageSha256": "2f89f273276862356e06b01b3377b54d1f11cb82eeb4614add455962c999e8cd",
        "imageWidth": 556,
        "imageHeight": 546
      },
      {
        "en": "Then she feels happy and says, \"I am Ms Phone. Here, look at my phones!\" That is Ms Phone and her five cellphones.",
        "sourceText": "Then she feels happy and says, \"I am Ms Phone. Here, look at my phones!\" That is Ms Phone and her five cellphones.",
        "zh": "她高兴地说：“我是手机女士，来，看看我的手机！”这就是手机女士和她的五部手机。",
        "tip": "选出孩子最喜欢的一种颜色，不用选手机。",
        "alt": "她高兴地说：“我是手机女士，来，看看我的手机！”这就是手机女士和她的五部手机。",
        "sourceImage": "https://raw.githubusercontent.com/global-asp/asp-imagebank/a56e6dbe7aeeb8ea3e53d9941664416e2e7356ad/medium/0105/13.jpg",
